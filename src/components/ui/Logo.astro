---
interface Props {
  size?: number;
  wordmark?: boolean;
  href?: string | null;
  class?: string;
  orbit?: number;
  beat?: boolean;
  wordSize?: number;
  gap?: number;
}

const {
  size = 23,
  wordmark = true,
  href = '/',
  class: className = '',
  orbit = 16,
  beat = false,
  wordSize = 15.5,
  gap = 10,
} = Astro.props;

const Tag = href ? 'a' : 'span';

const satellites = [
  { cx: 24, cy: 6 },
  { cx: 36.7, cy: 15.2 },
  { cx: 31.9, cy: 30.3 },
  { cx: 16.1, cy: 30.3 },
  { cx: 11.3, cy: 15.2 },
];
---

<Tag
  class={`logo ${className}`}
  href={href ?? undefined}
  style={`--orbit-dur: ${orbit}s; --logo-word-size: ${wordSize}px; --logo-gap: ${gap}px`}
>
  <svg width={size} height={size} viewBox="0 0 48 48" role="img" aria-label="MindStack">
    <g class="mark-orbit">
      {satellites.map((dot) => <circle cx={dot.cx} cy={dot.cy} r="2.6" fill="currentColor" />)}
    </g>
    <path
      class:list={['mark-core', { 'mark-beat': beat }]}
      d="M24 14 L31 19 L24 24 L17 19 Z"
      fill="var(--accent)"></path>
    <path class="mark-ghost" d="M24 32 L43 41 L24 45 L5 41 Z" fill="currentColor"></path>
  </svg>
  {wordmark && <span class="logo-word" aria-hidden="true">MindStack</span>}
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--logo-gap, 10px);
    color: inherit;
    text-decoration: none;
  }

  .logo:hover {
    color: inherit;
  }

  .logo svg {
    display: block;
    overflow: visible;
  }

  .mark-orbit {
    transform-box: fill-box;
    transform-origin: center;
    animation: lg-orbit var(--orbit-dur, 16s) linear infinite;
  }

  .mark-core {
    transform-box: fill-box;
    transform-origin: center;
  }

  .mark-beat {
    animation: lg-beat 2.6s ease-in-out infinite;
  }

  .mark-ghost {
    opacity: 0.22;
  }

  .logo-word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--logo-word-size, 15.5px);
    line-height: 1;
    letter-spacing: -0.015em;
  }

  @media (prefers-reduced-motion: reduce) {
    .mark-orbit,
    .mark-beat {
      animation: none;
    }
  }
</style>
