---
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import { primaryNav, conversionCta } from '../../lib/nav';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="header">
  <div class="shell header-inner">
    <Logo />

    <nav class="nav-desktop" aria-label="Primary">
      {
        primaryNav.map((item) => (
          <a
            class="nav-link"
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <Button href={conversionCta.href} class="header-cta">{conversionCta.label}</Button>
      <button
        id="ms-nav-trigger"
        class="hamburger"
        type="button"
        aria-expanded="false"
        aria-controls="ms-nav-sheet"
        aria-label="Open menu"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div id="ms-nav-sheet" class="sheet" hidden>
  <nav class="sheet-nav" aria-label="Primary mobile">
    {
      primaryNav.map((item) => (
        <a
          class="sheet-link"
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="sheet-foot">
    <Button href={conversionCta.href} size="lg" fullWidth>{conversionCta.label}</Button>
  </div>
</div>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 30;
    height: var(--header-h);
    display: flex;
    align-items: center;
    background: var(--surface-header);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-inner {
    width: 100%;
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 32px);
  }

  .nav-desktop {
    display: none;
    flex-wrap: wrap;
    gap: clamp(12px, 1.7vw, 22px);
  }

  .nav-link {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 14.5px;
    color: var(--text-secondary);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--text-primary);
  }

  .header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .header-cta {
    display: none;
    min-height: 38px;
    padding: 0 18px;
    font-size: 14px;
  }

  .hamburger {
    width: 38px;
    height: 38px;
    display: grid;
    place-content: center;
    gap: 5px;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: transparent;
    cursor: pointer;
  }

  .hamburger span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--text-primary);
  }

  .sheet {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: 29;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--bg);
    padding: var(--space-4) var(--page-margin) var(--space-6);
    overflow-y: auto;
  }

  .sheet[hidden] {
    display: none;
  }

  .sheet-nav {
    display: flex;
    flex-direction: column;
  }

  .sheet-link {
    display: flex;
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid var(--border-subtle);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    color: var(--text-primary);
  }

  .sheet-foot {
    padding-top: var(--space-5);
  }

  @media (min-width: 900px) {
    .nav-desktop,
    .header-cta {
      display: flex;
    }

    .hamburger,
    .sheet {
      display: none;
    }
  }
</style>

<script>
  const trigger = document.getElementById('ms-nav-trigger');
  const sheet = document.getElementById('ms-nav-sheet');

  if (trigger && sheet) {
    const focusable = () =>
      Array.from(sheet.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    const setOpen = (open: boolean) => {
      sheet.hidden = !open;
      trigger.setAttribute('aria-expanded', String(open));
      trigger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) focusable()[0]?.focus();
      else trigger.focus();
    };

    trigger.addEventListener('click', () => setOpen(sheet.hidden));

    document.addEventListener('keydown', (event) => {
      if (sheet.hidden) return;

      if (event.key === 'Escape') {
        setOpen(false);
        return;
      }

      if (event.key !== 'Tab') return;

      const items = focusable();
      if (!items.length) return;

      const first = items[0]!;
      const last = items[items.length - 1]!;
      const active = document.activeElement;

      if (event.shiftKey && active === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    });

    const wide = window.matchMedia('(min-width: 900px)');
    wide.addEventListener('change', (event) => {
      if (event.matches && !sheet.hidden) setOpen(false);
    });
  }
</script>
