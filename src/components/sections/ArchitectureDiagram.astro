---
const clients = [
  { x: 16, w: 136, label: 'Mobile browser' },
  { x: 168, w: 136, label: 'Admin browser' },
];

const app = [
  { x: 16, w: 136, label: 'Next.js 14 SSR' },
  { x: 168, w: 136, label: 'Admin SPA' },
];

const api = [
  { x: 16, w: 136, label: 'NestJS REST · JWT' },
  { x: 168, w: 136, label: 'Socket.io gateway' },
];

const data = [
  { x: 16, w: 90, label: 'PostgreSQL' },
  { x: 115, w: 90, label: 'Redis' },
  { x: 214, w: 90, label: 'Blob' },
];
---

<svg class="arch" viewBox="0 0 320 200" role="img" aria-label="Azure architecture: clients over Front Door, Next.js and admin SPA on App Service, NestJS API and Socket.io gateway, backed by PostgreSQL, Redis and Blob Storage">
  <g class="rails">
    <line x1="84" y1="32" x2="84" y2="48" />
    <line x1="236" y1="32" x2="236" y2="48" />
    <line x1="84" y1="70" x2="84" y2="84" />
    <line x1="236" y1="70" x2="236" y2="84" />
    <line x1="84" y1="108" x2="84" y2="118" />
    <line x1="236" y1="108" x2="236" y2="118" />
    <line x1="84" y1="142" x2="84" y2="158" />
    <line x1="160" y1="142" x2="160" y2="158" />
    <line x1="259" y1="142" x2="259" y2="158" />
  </g>

  {
    clients.map((box) => (
      <g class="node node-muted">
        <rect x={box.x} y={10} width={box.w} height={22} rx="5" />
        <text x={box.x + box.w / 2} y={24}>
          {box.label}
        </text>
      </g>
    ))
  }

  <g class="node node-edge">
    <rect x="16" y="48" width="288" height="22" rx="5" />
    <text x="160" y="62">Azure Front Door · WAF · CDN · TLS</text>
  </g>

  {
    [...app, ...api].map((box, index) => (
      <g class="node">
        <rect x={box.x} y={index < 2 ? 84 : 118} width={box.w} height={24} rx="5" />
        <text x={box.x + box.w / 2} y={index < 2 ? 99 : 133}>
          {box.label}
        </text>
      </g>
    ))
  }

  {
    data.map((box) => (
      <g class="node node-data">
        <rect x={box.x} y={158} width={box.w} height={24} rx="5" />
        <text x={box.x + box.w / 2} y={173}>
          {box.label}
        </text>
      </g>
    ))
  }
</svg>

<style>
  .arch {
    display: block;
    width: 100%;
    height: 100%;
  }

  .rails line {
    stroke: var(--border-strong);
    stroke-width: 1;
  }

  .node rect {
    fill: var(--surface-layer);
    stroke: var(--border-strong);
    stroke-width: 1;
  }

  .node text {
    fill: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 7.5px;
    text-anchor: middle;
    letter-spacing: 0.02em;
  }

  .node-muted rect {
    fill: transparent;
    stroke-dasharray: 3 2;
  }

  .node-edge rect {
    fill: color-mix(in oklab, var(--accent) 14%, transparent);
    stroke: var(--accent);
  }

  .node-edge text {
    fill: var(--text-primary);
  }

  .node-data rect {
    fill: var(--surface-band);
  }
</style>
