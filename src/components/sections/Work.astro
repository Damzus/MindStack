---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeader from './SectionHeader.astro';
import ArchitectureDiagram from './ArchitectureDiagram.astro';
import paradiseShot from '../../assets/work/paradise-group.png';
import allAboutHerShot from '../../assets/work/all-about-her.png';

interface WorkItem {
  sector: string;
  name: string;
  summary: string;
  href: string;
  external?: boolean;
  media: [string, string];
  shot?: ImageMetadata;
  diagram?: boolean;
  stack?: string[];
}

const cases: WorkItem[] = [
  {
    sector: 'Sector · Energy & tech services',
    name: 'Paradise Group',
    summary:
      'A multi-company Pacific energy and electrical group with products, services, careers and country operations spread across separate sites. Consolidated into one platform under a single brand. Outcome wording pending client approval.',
    href: 'https://paradise-gp.com/',
    external: true,
    media: ['Paradise Group · 16:10', ''],
    shot: paradiseShot,
    stack: ['WordPress', 'Elementor', 'Contact Form 7'],
  },
  {
    sector: 'Sector · Retail · beauty & wellness',
    name: 'All About Her',
    summary:
      'A curated beauty and lifestyle storefront selling into nine currencies, with collections, cart, account and newsletter built as a custom storefront rather than a themed template. Outcome wording pending client approval.',
    href: 'https://all-about-her.vercel.app',
    external: true,
    media: ['All About Her · 16:10', ''],
    shot: allAboutHerShot,
    stack: ['Next.js', 'Vercel', 'Multi-currency'],
  },
  {
    sector: 'Sector · Cloud platform',
    name: 'QR',
    summary:
      'A containerised Azure platform: Front Door with WAF and CDN in front of a Next.js 14 SSR site and admin SPA, a 9-module NestJS API behind a JWT guard, Socket.io for live events, and Postgres, Redis and Blob Storage underneath. Shipped by GitHub Actions through Container Registry, with secrets in Key Vault and telemetry into Application Insights.',
    href: '/work',
    media: ['Architecture diagram', 'or console view'],
    diagram: true,
    stack: ['Azure', 'NestJS', 'Terraform-ready'],
  },
];
---

<section class="section" id="work">
  <div class="shell">
    <SectionHeader
      eyebrow="Selected work"
      title="Constraint, decision, outcome."
      linkLabel="All work"
      linkHref="/work"
    />

    <div class="grid">
      {
        cases.map((item) => (
          <a
            class="case"
            href={item.href}
            data-reveal
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            <div class:list={['case-media', !item.shot && 'u-sheen']} data-anim-scope>
              {
                item.shot ? (
                  <Image
                    src={item.shot}
                    alt={`${item.name} homepage`}
                    widths={[400, 800, 1600]}
                    sizes="(min-width: 900px) 33vw, 100vw"
                    loading="eager"
                    fetchpriority="low"
                    decoding="async"
                  />
                ) : item.diagram ? (
                  <ArchitectureDiagram />
                ) : (
                  <span class="case-media-label">
                    {item.media[0]}
                    <br />
                    {item.media[1]}
                  </span>
                )
              }
            </div>
            <div class="case-body">
              <p class="eyebrow">{item.sector}</p>
              <h3 class="case-name">{item.name}</h3>
              <p class="case-summary">{item.summary}</p>
              {item.stack && (
                <div class="case-stack">
                  {item.stack.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
              <span class="case-cta">
                {item.external ? 'Visit the site ↗' : 'Read the case →'}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-3);
  }

  .case {
    display: flex;
    flex-direction: column;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    overflow: hidden;
    color: inherit;
    transition:
      border-color 200ms var(--ease),
      transform 200ms var(--ease);
  }

  .case:hover {
    border-color: var(--border-hover);
    color: inherit;
    transform: translateY(-3px);
  }

  .case-media {
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--border-subtle);
    background: repeating-linear-gradient(
      45deg,
      var(--placeholder-hatch) 0 8px,
      transparent 8px 16px
    );
  }

  .case-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .case-media-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.6;
    text-align: center;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .case-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(20px, 2.4vw, 28px);
  }

  .case-name {
    margin: var(--space-3) 0 10px;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.024em;
  }

  .case-summary {
    margin: 0 0 var(--space-4);
    font-size: 15px;
    color: var(--text-secondary);
  }

  .case-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--space-4);
  }

  .tag {
    height: 28px;
    display: inline-flex;
    align-items: center;
    padding: 0 11px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-tertiary);
  }

  .case-cta {
    margin-top: auto;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 15px;
    color: var(--accent-contrast);
  }

  @media (prefers-reduced-motion: reduce) {
    .case:hover {
      transform: none;
    }
  }
</style>
