---
import SectionHeader from './SectionHeader.astro';

const models = [
  {
    name: 'Project',
    range: 'Range TBC',
    body: 'Defined scope, fixed outcome, one delivery team. For a launch with a date attached.',
  },
  {
    name: 'Embedded team',
    range: 'Range TBC · per month',
    body: 'Ongoing capacity alongside your own engineers, with a named lead and a standing roadmap.',
  },
  {
    name: 'Managed infrastructure',
    range: 'Range TBC · per month',
    body: 'We run what we built, with a response commitment in writing. Available on its own.',
  },
];
---

<section class="section band" id="engagement">
  <div class="shell">
    <SectionHeader
      eyebrow="Engagement"
      title="Three ways to work with us, ranges published."
      linkLabel="How pricing works"
      linkHref="/engagement"
      narrow
    />

    <div class="grid">
      {
        models.map((model) => (
          <div class="model" data-reveal>
            <h3 class="model-name">{model.name}</h3>
            <p class="model-range">{model.range}</p>
            <p class="model-body">{model.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .band {
    background: var(--surface-band);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-3);
  }

  .model {
    padding: clamp(24px, 2.6vw, 32px);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
  }

  .model-name {
    margin-bottom: var(--space-2);
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .model-range {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13px;
    text-transform: uppercase;
    color: var(--accent-contrast);
  }

  .model-body {
    margin: 0;
    font-size: 14.5px;
    color: var(--text-secondary);
  }
</style>
