---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { serviceDetails } from '../../lib/services-detail';

export function getStaticPaths() {
  return serviceDetails.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<Base title={`${service.name} — MindStack`} description={service.lead}>
  <PageHeader eyebrow={service.eyebrow} title={service.name} lead={service.lead} />

  <section class="section">
    <div class="shell stack">
      <div class="two-up">
        <div class="panel">
          <p class="eyebrow">What's included</p>
          <ul class="list">
            {service.included.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="panel panel-dashed">
          <p class="eyebrow">What isn't us</p>
          <ul class="list list-muted">
            {service.notUs.map((item) => <li>{item}</li>)}
          </ul>
          <p class="micro">Saying no builds trust</p>
        </div>
      </div>

      <div class="panel">
        <p class="eyebrow">Stack &amp; tooling</p>
        <div class="tags">
          {service.stack.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </div>

      <div class="panel">
        <p class="eyebrow">How an engagement runs</p>
        <ol class="steps">
          {
            service.steps.map((step) => (
              <li>
                <span class="step-index">{step.index}</span>
                {step.label}
              </li>
            ))
          }
        </ol>
      </div>

      <div class="panel">
        <p class="eyebrow">Straight answers</p>
        <dl class="answers">
          {
            service.objections.map((item) => (
              <div class="answer">
                <dt>{item.q}</dt>
                <dd>{item.a}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .two-up {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-3);
  }

  .panel {
    padding: clamp(20px, 2.4vw, 28px);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
  }

  .panel-dashed {
    border-style: dashed;
    background: transparent;
  }

  .eyebrow {
    margin: 0 0 var(--space-4);
  }

  .list {
    margin: 0;
    padding-left: 18px;
    line-height: 1.9;
  }

  .list-muted {
    color: var(--text-secondary);
  }

  .micro {
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    height: 30px;
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-secondary);
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .steps li {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
  }

  .step-index {
    flex: none;
    width: 24px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-contrast);
  }

  .answers {
    margin: 0;
  }

  .answer {
    padding-block: var(--space-3);
    border-top: 1px solid var(--border-subtle);
  }

  .answer:first-child {
    border-top: none;
    padding-top: 0;
  }

  .answer dt {
    margin-bottom: 6px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
  }

  .answer dd {
    margin: 0;
    color: var(--text-secondary);
  }
</style>
